#!/usr/bin/env bash
# pixelmon-gui — web front end for pixelmon. Renders go to the server picked in its Setup tab
# (default 'local'), or: pixelmon-gui --server NAME  /  PIXELMON_SERVER=NAME pixelmon-gui
#   pixelmon-gui            -> http://127.0.0.1:8190
#   pixelmon-gui --lan      -> reachable from other devices on the LAN
set -euo pipefail
REPO="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
# Prefer ComfyUI's venv (has Pillow, for the palette readout); plain python3 works too, minus palettes.
PY="$HOME/ComfyUI/.venv/bin/python"
[ -x "$PY" ] || PY="$(command -v python3)"
exec "$PY" "$REPO/gui/server.py" "$@"
